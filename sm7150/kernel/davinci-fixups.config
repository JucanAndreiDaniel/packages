# davinci-fixups.config: parent symbols missing from arm64 defconfig that
# sm7150.config selections silently depend on. Without these, `make
# olddefconfig` drops e.g. the entire UFS storage stack and the USB HS PHY
# with no warning. Merged AFTER sm7150.config (and efi.config).

# --- SCSI / UFS storage (parents of CONFIG_SCSI_UFS_QCOM etc.) ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y

# --- USB (parent of USB_DWC3_ULPI and PHY_QCOM_USB_HS) ---
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ULPI_BUS=y

# --- Legacy g_ether must stay off: it would steal the UDC from the
# --- configfs gadget used by usb-network. (Overrides sm7150.config's
# --- CONFIG_USB_ETH_RNDIS=y, which olddefconfig currently drops anyway.)
# CONFIG_USB_ETH is not set
# CONFIG_USB_ETH_RNDIS is not set
